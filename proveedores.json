[
  {
    "id": "ovh",
    "name": "OVHcloud AI Endpoints",
    "group": "sin-cuenta",
    "base_url": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
    "keyless": { "rpm_model": 2 },
    "token": false,
    "free": "2 pedidos por minuto por modelo, sin registrarte",
    "signup": "https://www.ovhcloud.com/en/public-cloud/ai-endpoints/catalog/",
    "rotate": 8,
    "max_tokens": 3000,
    "json_mode": false,
    "helper": "gpt-oss-20b|Mistral-Small",
    "prefer": ["gpt-oss-120b", "Llama-3_3-70B", "Mistral-Small", "gpt-oss-20b", "Qwen3\\.6", "Qwen3\\.8", "Qwen3\\.5-397B", "Qwen3\\.5-9B"],
    "note": "Modelos abiertos alojados en Francia: gpt-oss, Llama 3.3, Qwen y Mistral. OVHcloud declara que no usa los prompts para entrenar. Con un token propio los modelos de chat se cobran, por eso acá solo se usa sin key."
  },
  {
    "id": "llm7",
    "name": "LLM7.io",
    "group": "sin-cuenta",
    "base_url": "https://api.llm7.io/v1",
    "env": "LLM7_API_KEY",
    "keyless": { "key": "unused", "rpm": 10, "models": ["mistral-Nemo-Instruct-2407", "gpt-oss", "gemma4:31b", "minimax-m2.7"] },
    "free": "10 pedidos por minuto sin cuenta; 40 con un token gratuito",
    "signup": "https://token.llm7.io",
    "only": "^(gpt-oss|gemma|minimax|mistral|deepseek|glm|kimi|llama|mimo|inkling)",
    "prefer": ["gpt-oss", "gemma4", "minimax", "mistral-Small", "deepseek", "glm", "kimi", "llama", "mistral-Nemo"],
    "note": "Pasarela independiente. Sin cuenta ofrece pocos modelos y cambian seguido (al 13 nov 2026 solo respondía Mistral Nemo); un token gratuito abre más. No publica qué hace con los prompts: no mandes nada confidencial."
  },
  {
    "id": "groq",
    "name": "Groq",
    "group": "email",
    "base_url": "https://api.groq.com/openai/v1",
    "env": "GROQ_API_KEY",
    "free": "30 pedidos por minuto y 1.000 por día por modelo",
    "signup": "https://console.groq.com/keys",
    "prefer": ["gpt-oss-120b", "qwen3\\.8", "qwen", "kimi", "llama-4", "llama", "gpt-oss"],
    "note": "El más rápido. Hoy sus modelos gratuitos son gpt-oss y Qwen."
  },
  {
    "id": "gemini",
    "name": "Google AI Studio (Gemini)",
    "group": "email",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "env": "GEMINI_API_KEY",
    "free": "15 pedidos por minuto y 1.500 por día",
    "signup": "https://aistudio.google.com/app/apikey",
    "only": "^gemini|^gemma",
    "max_tokens": 4000,
    "prefer": ["flash-latest", "flash(?!-lite)", "flash-lite", "gemma"],
    "note": "Modelos Gemini Flash. En el plan gratuito Google puede usar los prompts y las respuestas para mejorar sus modelos: no mandes nada confidencial."
  },
  {
