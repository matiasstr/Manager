# Copiá este archivo como .env y completá las keys que tengas.
# También se cargan desde la interfaz (Agentes → Proveedores de LLM), que es lo más cómodo.
# Con una sola alcanza; con varias, cada agente discute desde una LLM distinta.
# OVHcloud y LLM7 no necesitan key: se activan desde la interfaz.

GROQ_API_KEY=
HYPERBOLIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
REQUESTY_API_KEY=
OPENCODE_API_KEY=
AI_GATEWAY_API_KEY=
OLLAMA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ZAI_API_KEY=
AMD_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
LLM7_API_KEY=

# Opcional
# MANAGER_DATA=C:\ruta\a\mis\datos
# MANAGER_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   (más liviano: 220 MB)
# MANAGER_EMBEDDINGS=hash                                                           (sin descargar ningún modelo)
# MANAGER_ALLOW_ORIGINS=http://localhost:3000   (otras páginas tuyas que pueden llamar a la API)
